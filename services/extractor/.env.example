# FastAPI extractor + worker environment
# Copy this file to services/extractor/.env for standalone local execution,
# or provide the same values through your hosting platform secret manager.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
EXTRACTOR_HMAC_SECRET=REPLACE_WITH_SAME_STRONG_RANDOM_SECRET
MAX_DRAWING_BYTES=26214400
WORKER_POLL_SECONDS=0.25
AI_TIMEOUT_SECONDS=90

AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
