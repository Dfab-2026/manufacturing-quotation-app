# Next.js web app environment
# Copy this file to apps/web/.env.local for local development.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SERVER ONLY - never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
EXTRACTOR_URL=http://localhost:8001
EXTRACTOR_HMAC_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated emails allowed to access the cross-tenant platform admin screen.
PLATFORM_ADMIN_EMAILS=
