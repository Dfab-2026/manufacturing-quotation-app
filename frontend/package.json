{
  "name": "manufacturing-quotation-frontend-v3",
  "version": "0.14.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run release:check",
    "start": "next start -p 3000",
    "postinstall": "node scripts/copy-cad-runtime.mjs",
    "test:locator": "node --experimental-strip-types --test tests/drawingLocator.test.mjs",
    "test:routing": "node --experimental-strip-types --test tests/apiRouting.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/install-release.mjs --if-needed && node scripts/check-release.mjs && npm run test:release && npm run test:locator && npm run test:routing && next build && tsc --noEmit && npm audit --audit-level=high",
    "release:install": "node scripts/install-release.mjs",
    "test:release": "node --test tests/releasePolicy.test.mjs"
  },
  "dependencies": {
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "next": "^14.2.35",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
