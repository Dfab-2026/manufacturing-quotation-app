# Browser calls the Next.js proxy by default, avoiding CORS/port issues.
NEXT_PUBLIC_API_BASE_URL=/backend-api

# Server-side Next.js rewrite target for FastAPI.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# Optional direct browser-to-FastAPI URL used by Analyze first in hosted production.
# Example: https://your-fastapi-backend.vercel.app
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
