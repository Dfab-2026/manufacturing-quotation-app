# Supabase / PostgreSQL connection. For Supabase, use the Transaction Pooler URI.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Set this to the final Vercel frontend URL after the frontend is deployed.
# For local development keep localhost too.
FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# Render is a persistent service, so full local OCR is enabled.
LOCAL_OCR_ENABLED=false
MAX_UPLOAD_MB=100
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Optional vision fallback only if you choose to use it later.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
