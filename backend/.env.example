# Required production database (PostgreSQL / Neon / Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Drawing extraction is local/free in FastAPI (PyPDF + PyMuPDF + deterministic engineering rules).
# No Gemini/OpenAI/cloud AI key is required for normal PDF/DXF analysis.

# Frontend origins allowed by FastAPI CORS. Comma-separated for multiple domains.
FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# Optional SQLAlchemy pool tuning
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Maximum accepted upload size for drawings/CAD/training files
MAX_UPLOAD_MB=100
