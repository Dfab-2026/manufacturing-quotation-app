# =============================================================
# Manufacturing Quotation Platform - root environment template
# Copy this file to .env when using Docker Compose / root worker.
# For local Next.js also create apps/web/.env.local from its example.
# Never commit real secrets.
# =============================================================

# ---------- APP / SUPABASE ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------- WEB <-> EXTRACTOR ----------
EXTRACTOR_URL=http://localhost:8001
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EXTRACTOR_HMAC_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ---------- EXTRACTOR / WORKER ----------
MAX_DRAWING_BYTES=26214400
WORKER_POLL_SECONDS=2

# ---------- AI PROVIDER ----------
# Supported: gemini | openai | none
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Comma-separated emails allowed to access the cross-tenant platform admin screen.
PLATFORM_ADMIN_EMAILS=
